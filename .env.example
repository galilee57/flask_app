FLASK_CONFIG=development
SECRET_KEY=replace-with-a-random-private-key
ADMIN_API_TOKEN=replace-with-a-random-private-token
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Mac: local PostgreSQL. PythonAnywhere: use its hostname, port and app password.
# Docker connects to the same Mac database through host.docker.internal.
DATABASE_URL=postgresql+psycopg://flask_app:password@127.0.0.1:5432/flask_app
DOCKER_DATABASE_URL=postgresql+psycopg://flask_app:password@host.docker.internal:5432/flask_app
PORT=8080
# Defaults to the project's instance/ directory; set only if needed.
# FLASK_INSTANCE_PATH=/absolute/path/to/instance
# Optional immutable checkpoint available to every instance:
# SNAKE_DQN_PATH=/app/app/projects/snake/models/snake_dqn.npz
